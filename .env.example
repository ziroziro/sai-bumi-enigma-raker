# Mode backend: gunakan "supabase" untuk produksi/Vercel, atau "demo" untuk UI offline tanpa DB.
APP_DATA_MODE=supabase

# Kredensial Supabase milik Anda (Project Settings -> API Keys).
# PENTING: Hanya untuk server/backend. Jangan tambahkan prefix NEXT_PUBLIC_ dan jangan commit .env.local.
SUPABASE_URL=https://PROJECT_REF_ANDA.supabase.co
SUPABASE_SECRET_KEY=sb_secret_ISI_KEY_ANDA_DI_SINI
# Alternatif legacy (JWT role=service_role); isi salah satu saja (SUPABASE_SECRET_KEY atau SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SERVICE_ROLE_KEY=
# Opsional untuk CLI/import lokal; tidak dibaca oleh runtime aplikasi.
SUPABASE_DB_PASSWORD=

# Konfigurasi event & bucket Storage (harus sama dengan migration Supabase)
SUPABASE_EVENT_SLUG=the-sai-bumi-enigma-2026
SUPABASE_STORAGE_BUCKET=sai-bumi-team-photos

# Origin halaman aktif.
# - Lokal: http://localhost:3000
# - Vercel Production: https://nama-project-anda.vercel.app (atau custom domain https://...)
APP_ORIGIN=http://localhost:3000

# Secret HMAC >=32 karakter (disarankan acak 64 hex: openssl rand -hex 32)
RATE_LIMIT_SECRET=
UPLOAD_TOKEN_SECRET=
# Opsional: hanya diisi jika di depan Next.js ada reverse proxy sendiri (di Vercel biarkan kosong).
TRUSTED_PROXY_SECRET=

# Batas upload, signed URL, dan rate limit
UPLOAD_TTL_SECONDS=3600
UPLOAD_CLEANUP_GRACE_SECONDS=900
PHOTO_SIGNED_URL_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_RETENTION_SECONDS=172800
RATE_LIMIT_UPLOAD_ACTOR=20
RATE_LIMIT_UPLOAD_GLOBAL=100
RATE_LIMIT_SUBMIT_ACTOR=60
RATE_LIMIT_SUBMIT_GLOBAL=300

# Password akses panel pengawas (/admin-enigma) — ubah sesuai kebutuhan Anda
ADMIN_PASSWORD=P@ssw0rd#adminEnigma2026
